NEXT_PUBLIC_API_URL=http://127.0.0.1:3000
NEXT_PUBLIC_API_GRAPHQL_URL=http://127.0.0.1:3000/graphql

NEXT_PUBLIC_SITE_URL=http://127.0.0.1:7007

NEXT_PUBLIC_GOOGLE_CLIENT_ID=replace-with-google-client-id

NEXT_PUBLIC_KAKAO_REST_API_KEY=replace-with-kakao-rest-api-key
NEXT_PUBLIC_KAKAO_REDIRECT_URI=http://127.0.0.1:7007/account/kakao/callback
NEXT_PUBLIC_KAKAO_MAP_JS_KEY=replace-with-kakao-javascript-key

